<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy: allowBackup="false" (docs/superpowers/design/09-privacy-and-security.md §5)
      prevents user data leaving the device via OS auto-backup.
      Local-first by default: INTERNET is declared only to support the OPT-IN AI insight
      (Gemini, PRD v0.3 §10.8/§13.1). No request is ever made unless the user enables the
      AI toggle AND a key is configured (FR-AI7). All other features are offline-only.
    -->

    <!--
      Opt-in AI insight only (PRD v0.3 §13.1). Used exclusively by GeminiInsightSource when
      aiEnabled && key present; otherwise zero egress.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Digital Wellbeing (Phase 2, docs 08-permissions.md §?). PACKAGE_USAGE_STATS is a
      special access permission: it cannot be granted at runtime, the user enables it in
      Settings. The app stays fully functional as a Smart Todo without it (PRD §14).
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Interventions (Phase 3, docs 08-permissions.md, PRD §10.4). POST_NOTIFICATIONS is a
      runtime permission on Android 13+; when denied, the engine falls back to the in-app
      channel (FR-I3). Declared with maxSdkVersion-less form so it is requestable on 33+.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Focus foreground service (Phase 3, docs 08-permissions.md §5, PRD §10.5). Runs only while a
      focus session is active, with a persistent notification + emergency exit. FOREGROUND_SERVICE
      is required on all versions; FOREGROUND_SERVICE_SPECIAL_USE from Android 14 (API 34).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:ignore="ProtectedPermissions" />

    <!--
      Targeted package visibility (PRD docs 08-permissions.md §7): we deliberately avoid
      QUERY_ALL_PACKAGES. This <queries> entry lets Anchor see only apps with a launcher entry
      so the user can pick which apps to pause during Strict/Custom focus (FR-S4).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".AnchorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nemo"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Nemo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Handles the intervention notification's [Start Focus] / [Later] actions (FR-I7).
          Not exported: only Anchor itself posts these notifications.
        -->
        <receiver
            android:name=".platform.notification.InterventionActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.anchor.app.INTERVENTION_ACTION" />
            </intent-filter>
        </receiver>

        <!--
          Keeps a focus session alive with a persistent, transparent notification (FR-F7).
          `specialUse` matches docs 08 §5; not exported.
        -->
        <service
            android:name=".platform.service.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps an active focus session running with a visible notification." />
        </service>

        <!--
          Strict/Custom app blocking (FR-F4/F8, PRD v0.4 §10.5). Experimental, feature-flagged,
          opt-in. Requires the special BIND_ACCESSIBILITY_SERVICE permission and an explicit user
          grant in Settings → Accessibility. Reads only the window-change package name
          (canRetrieveWindowContent=false). Not exported.
        -->
        <service
            android:name=".platform.accessibility.AnchorAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/anchor_accessibility_config" />
        </service>

        <!--
          WorkManager is initialised via AnchorApp (Configuration.Provider) so @HiltWorker
          factories can be injected; disable the default initializer to avoid two configs.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

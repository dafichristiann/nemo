<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Privacy: allowBackup="false" (docs/superpowers/design/09-privacy-and-security.md §5)
      prevents user data leaving the device via OS auto-backup.
      No network permissions are declared (local-first, no AI in Sprint 0).
    -->

    <!--
      Digital Wellbeing (Phase 2, docs 08-permissions.md §?). PACKAGE_USAGE_STATS is a
      special access permission: it cannot be granted at runtime, the user enables it in
      Settings. The app stays fully functional as a Smart Todo without it (PRD §14).
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Interventions (Phase 3, docs 08-permissions.md, PRD §10.4). POST_NOTIFICATIONS is a
      runtime permission on Android 13+; when denied, the engine falls back to the in-app
      channel (FR-I3). Declared with maxSdkVersion-less form so it is requestable on 33+.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".AnchorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anchor"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Anchor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Handles the intervention notification's [Start Focus] / [Later] actions (FR-I7).
          Not exported: only Anchor itself posts these notifications.
        -->
        <receiver
            android:name=".platform.notification.InterventionActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.anchor.app.INTERVENTION_ACTION" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager is initialised via AnchorApp (Configuration.Provider) so @HiltWorker
          factories can be injected; disable the default initializer to avoid two configs.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>

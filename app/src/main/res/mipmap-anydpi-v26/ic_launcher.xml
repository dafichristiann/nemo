<?xml version="1.0" encoding="utf-8"?>
<!--
  Nemo adaptive launcher icon. The background colour is theme-aware (white in light, near-black
  in dark via values-night). The foreground is the Nemo mark (mipmap density buckets), plus a
  monochrome layer for Android 13+ themed icons (design-spec.md §2).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>

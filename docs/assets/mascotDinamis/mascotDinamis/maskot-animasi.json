{
  "name": "Animasi Maskot Nemo",
  "version": 1,
  "source_of_truth": "CSS di maskot-animasi-spec.md bagian 4",
  "conventions": {
    "units": {"x_y": "persen dari sisi kotak maskot (y positif = turun, x positif = ke kanan)", "rot": "derajat, positif = searah jarum jam", "sx_sy": "skala, 1 = ukuran asli", "opacity": "0 sampai 1", "t": "posisi dalam satu siklus, 0 sampai 1", "duration_ms": "milidetik per siklus", "reveal": "0 = tersembunyi, 1 = terlihat penuh"},
    "transform_order": "translate, lalu rotate, lalu scale, terhadap titik origin [x%, y%] kotak maskot (0,0 = kiri-atas)",
    "interpolation": "linear per parameter di antara keyframe; easing diterapkan di setiap segmen antar keyframe",
    "easing_defs": {"ease-in-out": "cubic-bezier(0.42,0,0.58,1)", "ease-out": "cubic-bezier(0,0,0.58,1)", "linear": "linear", "steps(3,end)": "nilai melompat 3 kali di setiap segmen; lompatan terjadi di akhir tiap langkah"},
    "loop": "semua animasi berulang tanpa henti; direction alternate = maju lalu mundur",
    "layers_bottom_to_top": ["head (wajah dasar)", "face_swaps (wajah lain menggantikan wajah dasar selama show_during, loncat langsung tanpa fade)", "fx (simbol)"],
    "layer_rules": "semua PNG persegi 760x760 dan kepalanya sudah sejajar; tumpuk semua layer di kotak yang sama tanpa crop atau penengahan ulang. body.transform berlaku untuk SEMUA layer; track fx berjalan di atas itu"
  },

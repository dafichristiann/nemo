# Anchor — Release keystore template.
#
# Copy this file to `keystore.properties` (repo root, git-ignored) and fill in real
# values before producing a signed store release. Without this file, `assembleRelease`
# still builds but signs with the debug key (fine for local testing only).
#
# Generate a keystore once:
#   keytool -genkeypair -v -keystore anchor-release.jks -alias anchor \
#     -keyalg RSA -keysize 2048 -validity 10000

storeFile=anchor-release.jks
storePassword=CHANGE_ME
keyAlias=anchor
keyPassword=CHANGE_ME
